+            return Ok(None);
+        };
+        let Some(next) = batch.next else {
+            break;
+        };
+        after = Some(next);
+        skipped += batch.skipped;
+        for record in batch.rows {
+            if visited.is_multiple_of(256) {
+                if let Some(control) = &control {
+                    control.check()?;
+                }
+            }
+            visited = visited.wrapping_add(1);
