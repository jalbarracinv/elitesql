+        let fetch = match limit {
+            Some(limit) => batch_rows
+                .min(
+                    offset
+                        .saturating_add(limit)
+                        .saturating_sub(skipped + out.len()),
+                )
+                .max(1),
+            None => batch_rows,
+        };
