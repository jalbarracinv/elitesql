-fn prepared_change<'a>(
-    staged: &'a [PreparedTable],
-    table: &str,
-    id: &str,
-) -> Option<&'a PreparedChange> {
-    let table = staged.iter().find(|candidate| candidate.name == table)?;
-    table
-        .changes
-        .binary_search_by(|change| change.id.as_str().cmp(id))
-        .ok()
-        .map(|index| &table.changes[index])
-}
