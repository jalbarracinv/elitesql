+                            vector_manifest_for(&key.0, &key.1, frozen_job.generation, index);
+                        if manifest.is_some() {
+                            index.durable_generation = Some(frozen_job.generation);
+                        }
+                        manifest
+                    })
+            }
+        };
+        match manifest {
+            None => {
+                let _ = fs::remove_file(&run);
+                continue;
+            }
+            Some(Some(manifest)) => {
+                manifest.publish(&vidx_manifest_path(&shared.dir, &key.0, &key.1))?;
+            }
+            Some(None) => {}
+        }
+    }
