+        }
+        if let Err(error) = writer.finish() {
+            let _ = fs::remove_file(&tmp);
+            return Err(error);
+        }
+        fs::rename(&tmp, &prepared).map_err(|error| {
+            Error::Io(std::io::Error::new(
+                error.kind(),
+                format!(
